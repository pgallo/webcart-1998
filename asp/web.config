<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>
    <!-- Server-side script libraries and include files are never served. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" />
          <add segment="include" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".inc" allowed="false" />
          <add fileExtension=".vbs" allowed="false" />
          <add fileExtension=".asa" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <asp scriptErrorSentToBrowser="false">
      <session allowSessionState="true" timeout="00:30:00" />
    </asp>
  </system.webServer>
</configuration>
